# Copy to .env (gitignored) and fill in whichever you have - none are
# required. See USAGE.md "Which parts actually use AI" and `janus doctor`.
# These are ONLY used by `janus scan recon --mode agent`; nothing else in
# Janus reads any of them.

# Set any subset - the agent ensemble (--agent-providers deepseek,glm,openai,
# the default) silently skips whichever provider's key isn't set.
DEEPSEEK_API_KEY=
GLM_API_KEY=
OPENAI_API_KEY=

# Alternative to the three above: one gateway key covering many models.
# See USAGE.md for how to point it at a specific model via providers.toml.
OPENROUTER_API_KEY=
